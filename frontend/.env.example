# Backend desplegado en Render (produccion).
# Vacio -> modo simulador local (sin backend).
VITE_API_URL=https://energiai-backend-g68o.onrender.com

# Fuerza el simulador aunque haya VITE_API_URL.
VITE_USE_MOCK=false

# Tarifa de referencia y simbolo de moneda.
VITE_TARIFA=0.75
VITE_MONEDA=$

# Timeout de red en ms (Render en frio puede tardar 30-50s).
VITE_TIMEOUT_MS=60000
